{%- for scheme in settings.color_schemes limit: 1 -%}{%- assign base_scheme = scheme -%}{%- endfor -%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    {% render 'meta-tags' %}
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="color-{{ base_scheme.id }} template-password">
    <main id="MainContent" class="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
