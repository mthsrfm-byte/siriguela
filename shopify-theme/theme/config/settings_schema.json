      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "default": false,
        "label": "t:settings_schema.cards.settings.card_show_vendor.label"
      },
      {
        "type": "checkbox",
        "id": "card_show_index",
        "default": true,
        "label": "t:settings_schema.cards.settings.card_show_index.label",
        "info": "t:settings_schema.cards.settings.card_show_index.info"
      },
      {
        "type": "checkbox",
        "id": "card_show_swatches",
        "default": true,
        "label": "t:settings_schema.cards.settings.card_show_swatches.label"
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "default": true,
        "label": "t:settings_schema.cards.settings.card_quick_add.label"
      }
    ]
  },
  {
    "name": "t:settings_schema.motion.name",
    "settings": [
      {
        "type": "checkbox",
        "id": "motion_reveal",
        "default": true,
        "label": "t:settings_schema.motion.settings.motion_reveal.label",
        "info": "t:settings_schema.motion.settings.motion_reveal.info"
      },
      {
        "type": "checkbox",
        "id": "motion_hover",
        "default": true,
        "label": "t:settings_schema.motion.settings.motion_hover.label"
      }
    ]
