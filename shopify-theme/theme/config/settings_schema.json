  {
    "name": "t:settings_schema.search.name",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search_enabled",
        "default": true,
        "label": "t:settings_schema.search.settings.predictive_search_enabled.label"
      }
    ]
  },
  {
    "name": "t:settings_schema.social.name",
    "settings": [
      { "type": "text", "id": "social_instagram_link", "label": "t:settings_schema.social.settings.instagram.label", "placeholder": "https://instagram.com/" },
      { "type": "text", "id": "social_tiktok_link", "label": "t:settings_schema.social.settings.tiktok.label", "placeholder": "https://tiktok.com/@" },
