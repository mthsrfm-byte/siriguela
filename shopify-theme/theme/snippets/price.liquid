{%- doc -%}
  Product or variant price, including sale, sold out and unit price states.

  @param {product} product - The product.
  @param {variant} [variant] - Variant to price. Defaults to the selected or first available variant.
  @param {boolean} [show_range] - Show "From" when variant prices differ.
{%- enddoc -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  if settings.currency_code_enabled
    assign price = target.price | money_with_currency
    assign compare = target.compare_at_price | money_with_currency
  else
    assign price = target.price | money
    assign compare = target.compare_at_price | money
  endif
  assign on_sale = false
  if target.compare_at_price > target.price
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--sale{% endif %}{% unless target.available %} price--sold-out{% endunless %}">
  {%- if show_range and product.price_varies -%}
    {%- liquid
      if settings.currency_code_enabled
        assign min = product.price_min | money_with_currency
      else
        assign min = product.price_min | money
      endif
    -%}
    <span class="price__current">{{ 'products.product.price.from_price_html' | t: price: min }}</span>
  {%- else -%}
    {%- if on_sale -%}
      <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
      <span class="price__current">{{ price }}</span>
      <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
      <s class="price__compare">{{ compare }}</s>
    {%- else -%}
      <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
      <span class="price__current">{{ price }}</span>
    {%- endif -%}
  {%- endif -%}
  {%- if target.unit_price_measurement -%}
    <small class="price__unit">
      <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
      {{ target.unit_price | money }}<span aria-hidden="true">/</span><span class="visually-hidden">&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span>
      {%- if target.unit_price_measurement.reference_value != 1 -%}{{ target.unit_price_measurement.reference_value }}{%- endif -%}
      {{ target.unit_price_measurement.reference_unit }}
    </small>
  {%- endif -%}
</div>
