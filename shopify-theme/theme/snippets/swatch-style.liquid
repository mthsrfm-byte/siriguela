{%- doc -%}
  Inline style for a swatch: image wins over color.

  @param {swatch} swatch - Swatch object from a product option value.
{%- enddoc -%}
{%- if swatch.image -%}
  --swatch: url({{ swatch.image | image_url: width: 60 }}) center / cover;
{%- elsif swatch.color -%}
  --swatch: {{ swatch.color }};
{%- endif -%}
