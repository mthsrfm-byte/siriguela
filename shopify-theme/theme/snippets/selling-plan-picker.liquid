{%- doc -%}
  Purchase options for products with selling plans (subscriptions,
  pre-orders). Hidden when the product has none.

  @param {product} product - The product.
  @param {variant} variant - Current variant.
  @param {string} form_id - Product form id.
  @param {string} section_id - Section id.
{%- enddoc -%}
{%- if product.selling_plan_groups.size > 0 -%}
  {%- liquid
    assign selected_plan = product.selected_selling_plan
    assign one_time = true
    if selected_plan
      assign one_time = false
    endif
  -%}
  <selling-plan-picker class="plans" role="radiogroup" aria-labelledby="Plans-{{ section_id }}" data-update="plans-{{ section_id }}">
    <p class="meta picker__label" id="Plans-{{ section_id }}">{{ 'products.product.purchase_options' | t }}</p>
    <input type="hidden" name="selling_plan" value="{{ selected_plan.id }}" form="{{ form_id }}" data-selling-plan>
    {%- unless product.requires_selling_plan -%}
      <label class="plans__option">
        <input type="radio" name="purchase_option-{{ section_id }}" value=""{% if one_time %} checked{% endif %}>
        <span class="plans__text">{{ 'products.product.one_time_purchase' | t }}</span>
        <span class="plans__price">{{ variant.price | money }}</span>
      </label>
    {%- endunless -%}
    {%- for group in product.selling_plan_groups -%}
      {%- for plan in group.selling_plans -%}
        {%- assign allocation = variant.selling_plan_allocations | where: 'selling_plan.id', plan.id | first -%}
        <label class="plans__option">
          <input type="radio" name="purchase_option-{{ section_id }}" value="{{ plan.id }}"{% if selected_plan.id == plan.id %} checked{% elsif product.requires_selling_plan and selected_plan == null and forloop.first %} checked{% endif %}>
          <span class="plans__text">
            {%- if product.selling_plan_groups.size > 1 -%}<span class="meta">{{ group.name | escape }}</span> {% endif -%}
            {{ plan.name | escape }}
            {%- if plan.description != blank -%}<small class="plans__desc">{{ plan.description | escape }}</small>{%- endif -%}
          </span>
          {%- if allocation -%}
            <span class="plans__price">
              {{ allocation.price | money }}
              {%- if allocation.compare_at_price > allocation.price -%} <s class="price__compare">{{ allocation.compare_at_price | money }}</s>{%- endif -%}
            </span>
          {%- endif -%}
        </label>
      {%- endfor -%}
    {%- endfor -%}
  </selling-plan-picker>
{%- endif -%}
