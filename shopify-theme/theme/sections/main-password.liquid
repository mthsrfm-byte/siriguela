{%- comment -%}
  Password page content.
{%- endcomment -%}
<div class="password color-{{ section.settings.color_scheme }}">
  <div class="password__inner page-width">
    <p class="header__wordmark">{{ shop.name | escape }}{% render 'signal' %}</p>
    <h1 class="display display--xl">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    {% render 'newsletter-form', id: 'PasswordSignup', large: true %}
    <details class="password__login">
      <summary class="link-quiet meta">{{ 'password.enter_store' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}<div class="form-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label for="Password" class="meta">{{ 'password.label' | t }}</label>
        <div class="newsletter-form__row">
          <input type="password" name="password" id="Password" class="field__input" autocomplete="current-password" required>
          <button type="submit" class="button">{{ 'password.enter' | t }}</button>
        </div>
      {%- endform -%}
      <p class="meta">{{ 'password.admin_html' | t: link: '/admin' }}</p>
    </details>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": [
    { "type": "text", "id": "heading", "default": "Opening soon", "label": "t:common.heading" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:common.color_scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
