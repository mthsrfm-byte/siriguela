{%- comment -%}
  Endless horizontal strip of images or short videos. Pauses on hover,
  on focus, with the pause button, and is static under reduced motion.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="section section--flush color-{{ s.color_scheme }}" aria-label="{{ s.label | escape }}">
  <media-reel class="reel" style="--reel-duration: {{ s.speed }}s; --reel-h: {{ s.height }}vh;">
    <div class="reel__track" data-reel-track>
      <ul class="reel__set" role="list">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <li class="reel__item" {{ block.shopify_attributes }}>
            {%- if b.link != blank -%}<a href="{{ b.link }}" class="reel__link">{%- endif -%}
              {%- if b.video != blank -%}
                {{ b.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'none', image_size: '720x', class: 'reel__media' }}
              {%- elsif b.image != blank -%}
                {{ b.image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1200', sizes: '(min-width: 750px) 30vw, 70vw', loading: 'lazy', class: 'reel__media', alt: b.image.alt | escape }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg reel__media' }}
              {%- endif -%}
              {%- if b.caption != blank -%}<span class="reel__caption meta">{{ b.caption | escape }}</span>{%- endif -%}
            {%- if b.link != blank -%}</a>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
    <button type="button" class="reel__toggle icon-button" data-reel-toggle aria-pressed="false" aria-label="{{ 'sections.media_reel.pause' | t }}">
      <span class="hero__pause-icon">{% render 'icon', name: 'pause' %}</span><span class="hero__play-icon">{% render 'icon', name: 'play' %}</span>
    </button>
  </media-reel>
</section>

{% schema %}
{
  "name": "t:sections.media_reel.name",
  "class": "section-media-reel",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "label", "default": "Campaign", "label": "t:sections.media_reel.settings.label.label", "info": "t:sections.media_reel.settings.label.info" },
    { "type": "range", "id": "height", "min": 30, "max": 90, "step": 5, "unit": "vh", "default": 60, "label": "t:sections.media_reel.settings.height.label" },
    { "type": "range", "id": "speed", "min": 20, "max": 120, "step": 5, "unit": "s", "default": 60, "label": "t:sections.media_reel.settings.speed.label" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:common.color_scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "media", "name": "t:sections.media_reel.blocks.media.name",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:common.image" },
        { "type": "video", "id": "video", "label": "t:sections.media_reel.blocks.media.settings.video.label" },
        { "type": "text", "id": "caption", "label": "t:common.caption" },
        { "type": "url", "id": "link", "label": "t:common.link" }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.media_reel.name", "blocks": [{ "type": "media" }, { "type": "media" }, { "type": "media" }, { "type": "media" }] }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
