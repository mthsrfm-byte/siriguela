{%- comment -%}
  Columns of short facts (materials, shipping, care) with meta labels.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="section color-{{ s.color_scheme }}" aria-labelledby="Heading-{{ section.id }}">
  <div class="page-width">
    {%- assign heading_id = 'Heading-' | append: section.id -%}
    {% render 'section-heading', heading: s.heading, caption: s.caption, id: heading_id %}
    <ul class="facts" role="list" style="--cols: {{ s.columns }};">
      {%- for block in section.blocks -%}
        <li class="fact" {{ block.shopify_attributes }} data-reveal>
          {%- if block.settings.image != blank -%}
            {% render 'media', image: block.settings.image, ratio: '3 / 2', sizes: '(min-width: 990px) 25vw, 100vw', class: 'fact__media' %}
          {%- endif -%}
          <span class="meta">{{ block.settings.label | escape }}</span>
          {%- if block.settings.title != blank -%}<h3 class="fact__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
          <div class="rte fact__text">{{ block.settings.text }}</div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.facts.name",
  "class": "section-facts",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:common.heading" },
    { "type": "text", "id": "caption", "label": "t:common.caption" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "default": 3, "label": "t:common.columns_desktop" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:common.color_scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "fact", "name": "t:sections.facts.blocks.fact.name",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:common.image" },
        { "type": "text", "id": "label", "default": "Materials", "label": "t:common.caption" },
        { "type": "text", "id": "title", "default": "Natural fibers", "label": "t:common.title" },
        { "type": "richtext", "id": "text", "default": "<p>Describe one reason to buy from you in a sentence or two.</p>", "label": "t:common.text" }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.facts.name", "blocks": [{ "type": "fact" }, { "type": "fact", "settings": { "label": "Shipping", "title": "Carbon-neutral delivery" } }, { "type": "fact", "settings": { "label": "Returns", "title": "30 days, no questions" } }] }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
