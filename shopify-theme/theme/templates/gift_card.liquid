{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_card.title' | t: value: gift_card.initial_value | money }} &ndash; {{ shop.name }}</title>
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="color-{{ settings.color_schemes.first.id }}">
    <main class="gift-card page-width">
      <p class="header__wordmark">{{ shop.name | escape }}{% render 'signal' %}</p>
      <h1 class="display display--lg">{{ 'gift_card.heading' | t }}</h1>
      <p class="gift-card__value">{{ gift_card.balance | money }}</p>
      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="badge badge--muted">{{ 'gift_card.expired' | t }}</p>
      {%- elsif gift_card.expires_on -%}
        <p class="meta">{{ 'gift_card.expires_on' | t: expires_on: gift_card.expires_on | date: format: 'date' }}</p>
      {%- endif -%}
      {%- if gift_card.initial_value != gift_card.balance -%}
        <p class="meta">{{ 'gift_card.initial_value' | t: value: gift_card.initial_value | money }}</p>
      {%- endif -%}
      <div class="gift-card__code">
        <label for="GiftCardCode" class="meta">{{ 'gift_card.code_label' | t }}</label>
        <input id="GiftCardCode" class="field__input" type="text" value="{{ gift_card.code | format_code }}" readonly onfocus="this.select()">
      </div>
      <div id="QrCode" class="gift-card__qr" data-identifier="{{ gift_card.qr_identifier }}" aria-label="{{ 'gift_card.qr_label' | t }}"></div>
      <div class="gift-card__actions">
        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}" class="gift-card__wallet">
            <img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_card.apple_wallet' | t }}" loading="lazy">
          </a>
        {%- endif -%}
        <button type="button" class="button button--secondary" onclick="window.print();">{{ 'gift_card.print' | t }}</button>
        <a href="{{ shop.url }}" class="button" target="_blank" rel="noopener">{{ 'gift_card.shop_link' | t }}</a>
      </div>
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (el && window.QRCode) new QRCode(el, { text: el.dataset.identifier, width: 160, height: 160, correctLevel: QRCode.CorrectLevel.H });
      });
    </script>
  </body>
</html>
