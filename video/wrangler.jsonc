{
  "name": "siriguela-video",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "services": [
    {
      "binding": "LOJA",
      "service": "siriguela"
    }
  ],
  "routes": [
    {
      "pattern": "siriguela.site/assets/video/*",
      "zone_name": "siriguela.site"
    }
  ]
}
