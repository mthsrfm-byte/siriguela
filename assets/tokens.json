{
  "$description": "Siriguela · direção Galeria com as cores do branding R01 Ponto. Formato Design Tokens (W3C). Espelha assets/css/tokens.css. ~90% neutro; siriguela só como ponto de cor.",
  "color": {
    "linho":            { "$type": "color", "$value": "#F3EFE8", "$description": "Fundo" },
    "papel":            { "$type": "color", "$value": "#FBF9F5", "$description": "Gaveta da sacola, campos" },
    "areia":            { "$type": "color", "$value": "#E4DCCF", "$description": "Rodapé, fundo atrás das fotos" },
    "tinta":            { "$type": "color", "$value": "#121212", "$description": "Texto, botão, logo" },
    "tinta-suave":      { "$type": "color", "$value": "#5E5953", "$description": "Texto secundário" },
    "cinza":            { "$type": "color", "$value": "#8F8980", "$description": "Índices, legendas" },
    "linha":            { "$type": "color", "$value": "#D9D1C4", "$description": "Fios de 1 px" },
    "siriguela":        { "$type": "color", "$value": "#B8322A", "$description": "O ponto: fim do título, logo, item ativo, foco, hover. Nunca texto corrido. Máx. dois por tela." },
    "siriguela-escura": { "$type": "color", "$value": "#8E241E", "$description": "Erro e alerta curto" }
  },
  "font": {
    "sans": { "$type": "fontFamily", "$value": ["Instrument Sans", "Helvetica Neue", "Arial", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "ui-monospace", "monospace"] }
  },
  "fontWeight": {
    "text":  { "$type": "fontWeight", "$value": 400 },
    "title": { "$type": "fontWeight", "$value": 500, "$description": "Peso máximo da marca" }
  },
  "grid": {
    "columns": { "$type": "number", "$value": 12 },
    "gap":     { "$type": "dimension", "$value": "clamp(8px, 1.1vw, 16px)" },
    "margin":  { "$type": "dimension", "$value": "clamp(16px, 4vw, 64px)" }
  }
}
